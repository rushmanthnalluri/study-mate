# StudyMate AI Environment Configuration

# Server Port (Render sets this automatically)
PORT=3001
NODE_ENV=production

# MongoDB Connection String (Render MongoDB or MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/studymate?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Online LLM Inference Keys (Leave blank for smart offline engine)
GROQ_API_KEY=
GEMINI_API_KEY=
