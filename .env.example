# StudyMate server configuration
# Never commit real secrets. Set production values in Render environment variables.
PORT=3001
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
STUDYMATE_CONFIG_SECRET=<long-random-secret>
STUDYMATE_ADMIN_EMAIL=admin@example.com
STUDYMATE_ADMIN_PASSWORD=<strong-random-password>
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
