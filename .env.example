# StudyMate server configuration
# Never commit real secrets. Set production values in Render environment variables.
PORT=3001
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
STUDYMATE_CONFIG_SECRET=<long-random-secret>
STUDYMATE_ADMIN_EMAIL=admin@example.com
STUDYMATE_ADMIN_PASSWORD=<strong-random-password>
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
XAI_API_KEY=
XAI_MODEL=grok-4
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
